APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Keep stored timestamps in UTC and present them in Philippine local time.
APP_DISPLAY_TIMEZONE=Asia/Manila

GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
# Optional separate server-side key restricted to Maps Static API.
GOOGLE_MAPS_STATIC_API_KEY=

# Municipality boundary geometry safeguards.
GEOFENCE_SIMPLIFY_ABOVE=2500
GEOFENCE_MAXIMUM_VERTICES=10000
GEOFENCE_SIMPLIFY_TOLERANCE=0.000005
GEOFENCE_NEAR_BOUNDARY_METERS=20

# Open-Meteo municipality forecasts (no API key required).
WEATHER_CACHE_MINUTES=30
WEATHER_STALE_HOURS=12
WEATHER_TIMEOUT_SECONDS=8
WEATHER_TIMEZONE=Asia/Manila
WEATHER_REFRESH_LOCK_SECONDS=30
WEATHER_REFRESH_WAIT_SECONDS=3

# Concurrent request and database write protection.
CONCURRENCY_LOCK_SECONDS=120
CONCURRENCY_WAIT_SECONDS=5
DB_TRANSACTION_ATTEMPTS=3

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
# End authenticated sessions after this many minutes without activity.
SESSION_LIFETIME=15
SESSION_IDLE_TIMEOUT=15

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
